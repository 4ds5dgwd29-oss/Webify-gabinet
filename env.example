# node scripts/setup-env.mjs tworzy .env z losowymi sekretami; nie publikuj .env.
DATABASE_URL="postgresql://webify:webify_local@localhost:5432/webify?schema=public"
POSTGRES_USER=webify
POSTGRES_PASSWORD=webify_local
POSTGRES_DB=webify
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
MASTER_ENCRYPTION_KEY=""
ALLOW_REGISTRATION=true
# true wyłącznie za proxy nadpisującym X-Forwarded-For.
TRUST_PROXY=false
DEMO_PASSWORD=""
TEST_DATABASE_URL="postgresql://webify:webify_local@localhost:5432/webify_test?schema=public"
# Kolejka, wygaszanie rezerwacji i retencja; minimum 32 losowe znaki.
CRON_SECRET=""
APP_INTERNAL_URL="http://app:3000"
# Abonament platformy. Price IDs ustaw w panelu administratora (test i live osobno).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# E-mail: Resend. Wymagane zweryfikowanie domeny nadawcy u operatora.
RESEND_API_KEY=""
EMAIL_FROM="Webify Gabinet <powiadomienia@example.test>"
SMSAPI_TOKEN=""
SMS_FROM=""
# local do uruchomienia lokalnego; na produkcji zalecane s3 w regionie UE.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH="./storage"
S3_REGION=eu-central-1
S3_BUCKET=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Kopie szyfrowane niezależnym kluczem 32 bajty base64. Przechowuj klucz poza kopiami.
BACKUP_ENCRYPTION_KEY=""
# Dla zdalnej bazy ustaw pełny URL z TLS; Compose ustawia własny adres wewnętrzny.
BACKUP_DATABASE_URL=""
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
# Bootstrap produkcyjnego administratora; wypełnij na czas jawnego uruchomienia skryptu.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator Webify"
